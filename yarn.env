# Environment variables injected by Yarn on every invocation (see .yarnrc.yml `injectEnvironmentFiles`).
# Keep this file committed and free of secrets.

# pa11y/pa11y-ci pull in puppeteer@1.19.0, whose postinstall script downloads a
# pinned Chromium build over HTTPS. Networks that intercept TLS (see e2e test
# notes in apps/web) cause that download to fail with
# UNABLE_TO_GET_ISSUER_CERT_LOCALLY, breaking `yarn`/`make watch`/`make start-local`
# even though nothing in this repo actually launches that bundled Chromium.
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
